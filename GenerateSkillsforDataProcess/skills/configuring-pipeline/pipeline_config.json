{
  "$schema": "./pipeline_config_schema.json",
  "_comment": "数据处理流水线统一配置 — 路径相对于项目根；敏感项可用 ${env:VAR} 从环境变量读取",
  "conda_env": "RAG",
  "_comment_conda_env": "运行 phase 脚本时使用的 conda 环境名；空表示当前环境。执行流水线前用户可在此选择。",
  "base_dir": "data",
  "input": {
    "raw_material": "${base_dir}/raw_material",
    "_comment": "用户放置原始文件的唯一入口"
  },
  "intermediate": {
    "source_file": "${base_dir}/source_file",
    "table_cache": "${base_dir}/processed_data/table_cache",
    "markdown": "${base_dir}/processed_data/markdown",
    "log_cache": "${base_dir}/processed_data/log_cache",
    "semantic_chunk": "${base_dir}/processed_data/semantic_chunk",
    "qa_pair": "${base_dir}/processed_data/qa_pair",
    "images": "${base_dir}/processed_data/images"
  },
  "output": {
    "chromadb": "${base_dir}/processed_data/chromadb_ver3",
    "hipporag_index": "${base_dir}/processed_data/hipporag_index",
    "manifests": "${base_dir}/processed_data/manifests",
    "run_log": "${base_dir}/processed_data/pipeline_run_log.jsonl"
  },
  "aws": {
    "region": "us-west-2",
    "bedrock_model": "us.anthropic.claude-sonnet-4-5-20250929-v1:0",
    "embedding_model": "amazon.titan-embed-text-v2:0",
    "_comment_vision": "PDF/图像理解可用 vision_model；phase3_image 可用 claude_model",
    "claude_model": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
    "vision_model": "us.anthropic.claude-3-5-sonnet-20241022-v2:0"
  },
  "unstructured": {
    "_comment": "Unstructured API（托管服务），非本地 SDK",
    "api_url": "https://api.unstructuredapp.io/general/v0/general",
    "api_key": "${env:UNSTRUCTURED_API_KEY}"
  },
  "tesseract": {
    "_comment": "本地 OCR 回退（可选）；PDF 主流程用 Unstructured API",
    "home": "${env:TESSERACT_HOME}",
    "lang": "chi_sim+eng"
  },
  "pdf": {
    "strategy": "hi_res",
    "doc_name_max_len": 120,
    "enable_pdf_annotation_links": true,
    "enable_image_to_text": true,
    "enable_image_understanding": true,
    "sort_targets": true
  },
  "log": {
    "log_suffixes": [
      ".log"
    ],
    "text_suffixes": [],
    "fault_window_seconds_before": 120,
    "fault_window_seconds_after": 300,
    "fault_merge_gap_seconds": 120,
    "fault_phrases_include": [
      "fail",
      "failed",
      "failure",
      "error",
      "err",
      "timeout",
      "time out",
      "reconnect",
      "exception",
      "abort",
      "fault",
      "reset",
      "错误",
      "失败",
      "异常",
      "故障",
      "超时",
      "rcvlen : 0",
      "rcvlen: 0",
      "rcvlen :0",
      "rcvLen : 0",
      "rcvLen: 0"
    ],
    "fault_phrases_exclude": [
      "open fail = 0",
      "open fail=0",
      "create success",
      "communication setup performance time",
      "getallserialcomfailednum null",
      "getprop persist.maxicharger.usbhuberrornum",
      "event_timeout_sounds",
      "timeoutmsounds",
      "erase timeout element",
      "totalerr=0",
      "workstatus=0",
      "reconnectupdata:0",
      "curstatus=0",
      "m_ccurtsta= 0"
    ]
  },
  "excel": {
    "run_batch": true,
    "supported_suffixes": [
      ".xlsx",
      ".xlsm",
      ".xltx",
      ".xltm"
    ]
  },
  "chunking_md": {
    "max_section_chars": 6000,
    "sub_chunk_size": 5000,
    "sub_chunk_overlap": 200
  },
  "chunking_log": {
    "max_log_chars_per_segment": 28000,
    "max_log_lines_per_segment": 600
  },
  "hipporag": {
    "llm_name": "bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0",
    "embedding_name": "amazon.titan-embed-text-v2:0"
  },
  "vectorizing": {
    "_comment": "向量库与 HippoRAG 建库策略：默认均为增量(upsert/incremental)，不重建",
    "chromadb": {
      "rebuild": false,
      "_comment": "true=每次重建 collection 清空再写；false=增量 upsert（默认）"
    },
    "hipporag": {
      "rebuild": false,
      "_comment": "true=强制从头建索引；false=增量只增新 passage（默认）"
    }
  }
}